# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output and dev files
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Local data: the SQLite database, its backups, and the encryption key.
# Never commit these. They hold your watchlist and secrets.
/data/
.secret-key

# Environment files and anything that starts with .env (e.g. .envtemp).
# Keep .env.example (it has no secrets) in git.
.env*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local helper scripts that aren't part of the project
resume-claude.bat

# Runtime state from start/stop scripts (PID and log files)
/.watcharr/

# Local AI tool configuration (machine-specific hook paths)
.claude/
.cursor/
.github/hooks/

# Scratch space and screenshots that aren't part of the docs
/temp/

# Certificates and coverage
*.pem
/coverage

# Vercel
.vercel
