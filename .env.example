# Copy to .env.local and fill in what you need. Never commit real values.

# Optional. A 32-byte key, base64-encoded, used to encrypt saved secrets.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, Watcharr creates a random key in data/.secret-key on first use.
# APP_SECRET_KEY=

# Optional. Folder for the SQLite database and the key file. Defaults to ./data.
# DB_DIR=./data
